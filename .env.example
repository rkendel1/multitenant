# =============================================================================
# Multitenant Docker Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings.
# 
# Usage:
#   cp .env.example .env
#   # Edit .env with your settings
#   docker compose up -d
# =============================================================================

# =============================================================================
# General Settings
# =============================================================================

# Node environment (development, production, test)
NODE_ENV=development

# Django debug mode
DEBUG=True

# Django secret key (change in production!)
SECRET_KEY=your-secret-key-change-in-production

# Allowed hosts for Django
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# PostgreSQL Database
# =============================================================================

# Database credentials
POSTGRES_USER=multitenant
POSTGRES_PASSWORD=multitenant_secret
POSTGRES_DB=multitenant_db

# External port for PostgreSQL
POSTGRES_PORT=5432

# =============================================================================
# Convex (Local Development)
# =============================================================================

# Port for the local Convex mock server
CONVEX_PORT=3210

# For Convex Cloud (production), use these instead:
# CONVEX_DEPLOYMENT_URL=https://your-deployment.convex.cloud
# CONVEX_API_TOKEN=your-convex-api-token

# =============================================================================
# Application Ports
# =============================================================================

# Node.js application port
APP_PORT=3000

# Django application port
DJANGO_PORT=8000

# Redis port (if using cache profile)
REDIS_PORT=6379

# Adminer (database admin UI) port
ADMINER_PORT=8080

# =============================================================================
# Multitenancy Configuration
# =============================================================================

# Base domain for subdomain-based tenancy
# In development: localhost
# In production: yourapp.com
MULTITENANT_BASE_DOMAIN=localhost

# =============================================================================
# OAuth Configuration (Optional)
# =============================================================================

# GitHub OAuth
# Get credentials at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# Platform Owner / Admin
# =============================================================================

# Platform owner email (super admin)
MULTITENANT_ADMIN_EMAIL=admin@example.com

# Platform owner password (change this!)
MULTITENANT_ADMIN_PASSWORD=admin123

# =============================================================================
# Optional: Django Settings Module
# =============================================================================
# Point to your Django settings module
# DJANGO_SETTINGS_MODULE=config.settings
